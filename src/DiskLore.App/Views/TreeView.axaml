<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskLore.App.ViewModels"
             xmlns:v="using:DiskLore.App.Views"
             xmlns:ctl="using:DiskLore.App.Controls"
             xmlns:c="using:DiskLore.App.Converters"
             x:Class="DiskLore.App.Views.DiskTreeView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- Header: columns must match the row template below -->
    <Border Grid.Row="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,0,0,1" Height="28">
      <Grid ColumnDefinitions="4*,84,92,84,3*,120" Margin="8,0,16,0">
        <Button Grid.Column="0" Classes="ghost" Content="{Binding Tree.NameHeader}" Click="OnSortName"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontWeight="SemiBold" MinHeight="24" Padding="40,0,0,0" />
        <Button Grid.Column="1" Classes="ghost" Content="{Binding Tree.SizeHeader}" Click="OnSortSize"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" FontWeight="SemiBold" MinHeight="24" />
        <TextBlock Grid.Column="2" Text="Share" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" Classes="muted" />
        <TextBlock Grid.Column="3" Text="Badge" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Classes="muted" />
        <TextBlock Grid.Column="4" Text="What it is" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Classes="muted" />
        <Button Grid.Column="5" Classes="ghost" Content="{Binding Tree.ChangedHeader}" Click="OnSortChanged"
                IsVisible="{Binding ShowLastChanged}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                FontWeight="SemiBold" MinHeight="24" />
      </Grid>
    </Border>

    <ListBox x:Name="Rows" Grid.Row="1" Classes="rows" ItemsSource="{Binding Tree.Rows}"
             SelectionMode="Single" KeyDown="OnRowsKeyDown"
             SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource App.Hover}" />
          </Style>
          <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource App.Selection}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
          </Style>
          <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource App.Selection}" />
          </Style>
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TreeRowViewModel">
          <Grid Height="27" ColumnDefinitions="4*,84,92,84,3*,120" Margin="8,0,16,0"
                Background="Transparent" DoubleTapped="OnRowDoubleTapped">
            <Grid.ContextMenu>
              <ContextMenu Opening="OnContextMenuOpening">
                <MenuItem Name="MiOpen" Header="Open in file manager" Click="OnMenuOpen" />
                <MenuItem Name="MiCopy" Header="Copy path" Click="OnMenuCopy" />
                <Separator />
                <MenuItem Name="MiAsk" Header="Ask AI" Click="OnMenuAsk" />
                <MenuItem Name="MiLock" Header="Check in use" Click="OnMenuLock" />
                <MenuItem Name="MiTreemap" Header="Show in Treemap" Click="OnMenuTreemap" />
                <Separator />
                <MenuItem Name="MiRecycle" Header="Move to Recycle Bin" Click="OnMenuRecycle" />
                <MenuItem Name="MiDelete" Header="Delete permanently" Click="OnMenuDelete" />
              </ContextMenu>
            </Grid.ContextMenu>

            <!-- Name cell -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" IsVisible="{Binding IsNode}" ClipToBounds="True">
              <Border Width="{Binding IndentWidth}" />
              <Panel Width="20" Height="22">
                <Button Classes="ghost" Width="20" Height="22" MinHeight="0" Padding="0"
                        IsVisible="{Binding HasChildren}" Click="OnChevronClick" Focusable="False">
                  <Path Classes="chevron" Classes.expanded="{Binding IsExpanded}" Data="{StaticResource Icon.Chevron}"
                        Width="10" Height="10" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
                </Button>
              </Panel>
              <Panel Width="20" Height="20" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsFolder}" Width="15" Height="15" Stretch="Uniform"
                      Fill="{DynamicResource App.SurfaceAlt}" Stroke="{DynamicResource App.TextMuted}" StrokeThickness="1.1"
                      StrokeJoin="Round" />
                <Path Data="{StaticResource Icon.Lock}" IsVisible="{Binding IsLocked}" Width="13" Height="13" Stretch="Uniform"
                      Fill="{DynamicResource App.Warning}" />
                <Path Data="{StaticResource Icon.Chevron}" IsVisible="{Binding IsJunction}" Width="12" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource App.TextMuted}" StrokeThickness="1.4" />
                <Path Data="{StaticResource Icon.File}" IsVisible="{Binding IsFile}" Width="12" Height="14" Stretch="Uniform"
                      Stroke="{DynamicResource App.TextMuted}" StrokeThickness="1.1" StrokeJoin="Round" />
              </Panel>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"
                         FontWeight="{Binding IsFolder, Converter={x:Static c:RowConverters.FolderWeight}}" />
              <TextBlock Text="{Binding LinkText}" IsVisible="{Binding IsJunction}" Classes="muted" VerticalAlignment="Center"
                         Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding SizeText}" IsVisible="{Binding IsNode}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontFeatures="tnum" />

            <Grid Grid.Column="2" ColumnDefinitions="*,34" Margin="14,0,0,0" IsVisible="{Binding IsNode}" VerticalAlignment="Center">
              <ProgressBar Classes="mini" Value="{Binding Fraction}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="muted small" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>

            <ctl:BadgePill Grid.Column="3" Margin="8,0,0,0" Badge="{Binding Badge}" IsVisible="{Binding ShowBadge}" />

            <TextBlock Grid.Column="4" Text="{Binding Summary}" Classes="muted" Margin="8,0,8,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" IsVisible="{Binding IsNode}"
                       ToolTip.Tip="{Binding SummaryTip}" />

            <TextBlock Grid.Column="5" Text="{Binding ChangedText}" Classes="muted small" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[v:DiskTreeView].((vm:MainViewModel)DataContext).ShowLastChanged}" />

            <!-- Pager row -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" IsVisible="{Binding IsShowMore}">
              <Border Width="{Binding IndentWidth}" />
              <Button Classes="link" Margin="20,0,0,0" Click="OnShowMoreClick" Focusable="False">
                <TextBlock Text="{Binding MoreText}" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Search results overlay -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource App.Background}" IsVisible="{Binding IsSearchOpen}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,6" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding SearchSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Close" Classes="ghost" Command="{Binding ClearSearchCommand}" />
          </Grid>
        </Border>
        <ListBox x:Name="Results" Classes="rows" ItemsSource="{Binding SearchResults}"
                 SelectionChanged="OnResultSelected">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchResultViewModel">
              <Grid ColumnDefinitions="*,84,84" Margin="14,4" MinHeight="34">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FullPath}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <ctl:BadgePill Grid.Column="2" Badge="{Binding Badge}" HorizontalAlignment="Right" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
