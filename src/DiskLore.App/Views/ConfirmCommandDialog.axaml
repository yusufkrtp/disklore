<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskLore.App.Views.ConfirmCommandDialog"
        Title="Run command" Width="560" SizeToContent="Height" CanResize="False"
        Icon="/Assets/disklore.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="TitleText" Classes="title" FontSize="16" />
    <TextBlock x:Name="IntroText" Classes="muted body" />
    <Border Classes="card" Padding="12,10" Background="{DynamicResource App.SurfaceAlt}">
      <SelectableTextBlock x:Name="CommandText" FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                           TextWrapping="Wrap" />
    </Border>
    <TextBlock x:Name="AdminText" Text="Runs as administrator. Windows will ask you to confirm."
               Foreground="{DynamicResource App.Warning}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CopyButton" Content="Copy command" Click="OnCopy" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="RunButton" Content="Run as administrator" Classes="primary" Click="OnRun" />
    </StackPanel>
  </StackPanel>
</Window>
