<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskLore.App.ViewModels.Tabs"
             xmlns:c="using:DiskLore.App.Controls"
             x:Class="DiskLore.App.Views.Tabs.LargestFilesView"
             x:DataType="vm:LargestFilesViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="12,6">
      <Grid ColumnDefinitions="40,2*,86,3*,2*,96" TextElement.FontSize="11"
            TextElement.Foreground="{DynamicResource App.TextMuted}">
        <TextBlock Grid.Column="0" Text="#" />
        <TextBlock Grid.Column="1" Text="Name" />
        <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Margin="0,0,12,0" />
        <TextBlock Grid.Column="3" Text="What it is" />
        <TextBlock Grid.Column="4" Text="Folder" />
        <TextBlock Grid.Column="5" Text="Last changed" />
      </Grid>
    </Border>

    <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent"
             DoubleTapped="OnDoubleTapped" KeyDown="OnKeyDown">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="12,5" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open in file manager" Click="OnReveal" />
          <MenuItem Header="Move to Recycle Bin" Click="OnRecycle" />
          <MenuItem Header="Delete permanently" Click="OnDeletePermanently" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LargestFileRow">
          <Grid ColumnDefinitions="40,2*,86,3*,2*,96">
            <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{DynamicResource App.TextMuted}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource App.Text}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip.Tip="{Binding Node.FullPath}" />
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource App.Text}"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
              <c:BadgePill Badge="{Binding Badge}" />
              <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource App.TextMuted}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="4" Text="{Binding ParentText}" Foreground="{DynamicResource App.TextMuted}"
                       VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding ParentFull}" />
            <TextBlock Grid.Column="5" Text="{Binding ModifiedText}" Foreground="{DynamicResource App.TextMuted}"
                       VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1" Text="{Binding Status}" IsVisible="{Binding !HasRows}"
               Foreground="{DynamicResource App.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" MaxWidth="480" />
  </Grid>
</UserControl>
