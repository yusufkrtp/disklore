<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskLore.App.ViewModels.Tabs"
             xmlns:c="using:DiskLore.App.Controls"
             x:Class="DiskLore.App.Views.Tabs.ChangesView"
             x:DataType="vm:ChangesViewModel">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasContent}">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="12,10,12,6">
        <TextBlock Text="Compare with" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" MinWidth="260">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SnapshotChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource App.Text}" FontSize="15"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="1" Background="{DynamicResource App.Surface}"
              BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1" Padding="12,6">
        <Grid ColumnDefinitions="3*,84,84,96,3*" TextElement.FontSize="11"
              TextElement.Foreground="{DynamicResource App.TextMuted}">
          <TextBlock Grid.Column="0" Text="Folder" />
          <TextBlock Grid.Column="1" Text="Before" HorizontalAlignment="Right" Margin="0,0,12,0" />
          <TextBlock Grid.Column="2" Text="Now" HorizontalAlignment="Right" Margin="0,0,12,0" />
          <TextBlock Grid.Column="3" Text="Change" HorizontalAlignment="Right" Margin="0,0,12,0" />
          <TextBlock Grid.Column="4" Text="What it is" />
        </Grid>
      </Border>

      <ListBox x:Name="List" Grid.Row="2" ItemsSource="{Binding Rows}" Background="Transparent"
               DoubleTapped="OnDoubleTapped" KeyDown="OnKeyDown">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ChangeRow">
            <Grid ColumnDefinitions="3*,84,84,96,3*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource App.Text}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" />
                <Border IsVisible="{Binding HasTag}" Background="{DynamicResource App.SurfaceAlt}"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="6,0">
                  <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding OldText}" Foreground="{DynamicResource App.TextMuted}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="{Binding NewText}" Foreground="{DynamicResource App.Text}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Panel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DeltaText}" IsVisible="{Binding IsGrowth}" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Accent}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DeltaText}" IsVisible="{Binding IsShrink}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Badge.Safe}" HorizontalAlignment="Right" />
              </Panel>
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          IsVisible="{Binding HasBadge}">
                <c:BadgePill Badge="{Binding Badge}" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource App.TextMuted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding !HasContent}"
               Foreground="{DynamicResource App.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
  </Grid>
</UserControl>
