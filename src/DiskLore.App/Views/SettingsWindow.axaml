<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskLore.App.ViewModels"
        xmlns:th="using:DiskLore.App.Themes"
        x:Class="DiskLore.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="560" Height="720" MinWidth="480" MinHeight="400"
        Icon="/Assets/disklore.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,1,0,0" Background="{DynamicResource App.Surface}">
      <Button Content="Done" Classes="primary" HorizontalAlignment="Right" MinWidth="88" Click="OnDone" />
    </Border>
    <ScrollViewer>
      <StackPanel Margin="20,12,20,14" Spacing="10" MaxWidth="560">

        <StackPanel Spacing="6">
          <TextBlock Text="Theme" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="4">
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="5,3" />
                  <Setter Property="Margin" Value="1" />
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="th:ThemeOption">
                  <StackPanel Spacing="3">
                    <Border Height="18" CornerRadius="4" ClipToBounds="True"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            Background="{Binding Background}">
                      <Grid ColumnDefinitions="*,*,*" Margin="3">
                        <Border Grid.Column="0" Background="{Binding Surface}" CornerRadius="2" Margin="0,0,2,0" />
                        <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="2" Margin="0,0,2,0" />
                        <Border Grid.Column="2" Background="{Binding Text}" CornerRadius="2" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="AI explanations" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="12,10">
            <StackPanel Spacing="8">
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem" x:DataType="vm:ProviderChoice">
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                  </Style>
                </ComboBox.Styles>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProviderChoice">
                    <Grid>
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding IsNormal}" />
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding IsHeader}" Classes="muted small"
                                 FontWeight="SemiBold" Margin="0,4,0,0" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="{Binding Description}" Classes="muted small" TextWrapping="Wrap" />

              <StackPanel IsVisible="{Binding HasProvider}" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="●" Foreground="{DynamicResource Badge.Safe}" IsVisible="{Binding StatusIsReady}" VerticalAlignment="Center" />
                  <TextBlock Text="●" Foreground="{DynamicResource App.Warning}" IsVisible="{Binding StatusIsProblem}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                </StackPanel>

                <!-- Subscription CLI -->
                <StackPanel IsVisible="{Binding IsCli}" Spacing="2">
                  <TextBlock Text="{Binding CliHint}" Classes="muted small" TextWrapping="Wrap" />
                  <Button Content="{Binding SetupLinkLabel}" Command="{Binding OpenSetupUrlCommand}" Classes="link"
                          HorizontalAlignment="Left" Margin="-4,0,0,0" />
                </StackPanel>

                <!-- API key -->
                <StackPanel IsVisible="{Binding UsesKey}" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding ApiKeyInput}" PasswordChar="●" PlaceholderText="{Binding KeyPlaceholder}" />
                    <Button Grid.Column="1" Content="Save" Command="{Binding SaveKeyCommand}" IsEnabled="{Binding CanSaveKey}" />
                    <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveKeyCommand}" IsVisible="{Binding HasStoredKey}" />
                  </Grid>
                  <TextBlock Text="{Binding KeyStorageNote}" Classes="muted small" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding KeyMessage}" Classes="muted small" TextWrapping="Wrap"
                             IsVisible="{Binding KeyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Button Content="{Binding SetupLinkLabel}" Command="{Binding OpenSetupUrlCommand}" Classes="link"
                          IsVisible="{Binding HasSetupUrl}" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                </StackPanel>

                <!-- Local model: only the link; the base URL and model rows below do the rest -->
                <Button Content="{Binding SetupLinkLabel}" Command="{Binding OpenSetupUrlCommand}" Classes="link"
                        IsVisible="{Binding ShowLocalLink}" HorizontalAlignment="Left" Margin="-4,0,0,0" />

                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Text="Base URL" VerticalAlignment="Center" IsVisible="{Binding ShowBaseUrl}" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BaseUrl}" PlaceholderText="{Binding BaseUrlPlaceholder}"
                           IsVisible="{Binding ShowBaseUrl}" />
                  <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" />
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox IsEditable="True" ItemsSource="{Binding ModelOptions}" Text="{Binding Model}"
                              PlaceholderText="{Binding ModelPlaceholder}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Load models" Command="{Binding LoadModelsCommand}"
                            IsEnabled="{Binding CanLoadModels}" IsVisible="{Binding !IsCli}" />
                  </Grid>
                </Grid>
                <TextBlock Text="{Binding ModelsText}" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding ModelsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding CanTest}" />
                  <TextBlock Text="{Binding TestText}" IsVisible="{Binding TestShowOk}" VerticalAlignment="Center"
                             TextWrapping="Wrap" MaxWidth="330" Classes="small" Foreground="{DynamicResource Badge.Safe}" />
                  <TextBlock Text="{Binding TestText}" IsVisible="{Binding TestShowBad}" VerticalAlignment="Center"
                             TextWrapping="Wrap" MaxWidth="330" Classes="small" Foreground="{DynamicResource App.Warning}" />
                  <TextBlock Text="{Binding TestText}" IsVisible="{Binding IsTesting}" VerticalAlignment="Center"
                             Classes="muted small" />
                </StackPanel>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,2" />

              <CheckBox IsChecked="{Binding AiAuto}" Content="Explain big unknown folders automatically after a scan" />
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="Only items at least this big (GB)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ThresholdGb}" Minimum="0" Maximum="1024"
                               Increment="0.5" FormatString="0.##" />
                <TextBlock Grid.Row="1" Text="Max AI calls per scan" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxCalls}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" />
              </Grid>
              <Button Content="{Binding ClearCacheLabel}" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="General" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="12,10">
            <StackPanel Spacing="8">
              <CheckBox IsChecked="{Binding ShowLastChanged}" Content="Show the “Last changed” column" />
              <CheckBox IsChecked="{Binding ShellEnabled}" IsVisible="{Binding ShellSupported}"
                        Content="Add “Open in DiskLore” to the Explorer right-click menu" />
              <Grid ColumnDefinitions="Auto,*">
                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                <TextBlock Grid.Column="1" Text="{Binding DataFolder}" Classes="muted small" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
