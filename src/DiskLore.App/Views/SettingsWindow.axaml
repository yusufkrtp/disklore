<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskLore.App.ViewModels"
        xmlns:th="using:DiskLore.App.Themes"
        x:Class="DiskLore.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="560" Height="720" MinWidth="480" MinHeight="400"
        Icon="/Assets/disklore.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,1,0,0" Background="{DynamicResource App.Surface}">
      <Button Content="Done" Classes="primary" HorizontalAlignment="Right" MinWidth="88" Click="OnDone" />
    </Border>
    <ScrollViewer>
      <StackPanel Margin="20,16,20,20" Spacing="16" MaxWidth="560">

        <StackPanel Spacing="8">
          <TextBlock Text="Theme" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="6">
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="th:ThemeOption">
                  <Grid ColumnDefinitions="Auto,*" Height="30">
                    <Border Width="64" Height="20" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            Background="{Binding Background}">
                      <Grid ColumnDefinitions="*,*,*" Margin="3">
                        <Border Grid.Column="0" Background="{Binding Surface}" CornerRadius="2" Margin="0,0,2,0" />
                        <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="2" Margin="0,0,2,0" />
                        <Border Grid.Column="2" Background="{Binding Text}" CornerRadius="2" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Claude explanations" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding AiAvailabilityText}" Classes="muted small" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding AiAuto}" Content="Explain big unknown folders automatically after a scan" />
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="Only items at least this big (GB)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ThresholdGb}" Minimum="0" Maximum="1024"
                               Increment="0.5" FormatString="0.##" />
                <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2" Text="Max Claude calls per scan" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxCalls}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" />
              </Grid>
              <Button Content="{Binding ClearCacheLabel}" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="General" Classes="title" FontSize="15" />
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="12">
              <CheckBox IsChecked="{Binding ShowLastChanged}" Content="Show the “Last changed” column" />
              <CheckBox IsChecked="{Binding ShellEnabled}" IsVisible="{Binding ShellSupported}"
                        Content="Add “Open in DiskLore” to the Explorer right-click menu" />
              <StackPanel Spacing="4">
                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding DataFolder}" Classes="muted small" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
