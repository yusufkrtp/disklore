<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:DiskLore.App.Views"
        xmlns:t="using:DiskLore.App.Views.Tabs"
        xmlns:vm="using:DiskLore.App.ViewModels"
        x:Class="DiskLore.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DiskLore" Width="1280" Height="800" MinWidth="960" MinHeight="560"
        Icon="/Assets/disklore.ico"
        Background="{DynamicResource App.Background}">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="10,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Classes="ghost" Command="{Binding HomeCommand}" ToolTip.Tip="Back to the drive list">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource Icon.Home}" Stroke="{DynamicResource App.Text}" StrokeThickness="1.3"
                  StrokeJoin="Round" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
            <TextBlock Text="Home" />
          </StackPanel>
        </Button>

        <Border Grid.Column="1" Margin="8,0,0,0" Padding="10,3" CornerRadius="6" VerticalAlignment="Center"
                Background="{DynamicResource App.SurfaceAlt}" IsVisible="{Binding HasResult}" MaxWidth="360">
          <TextBlock Text="{Binding RootPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding RootPath}" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0"
                    IsVisible="{Binding HasResult}">
          <Button Content="Rescan" Command="{Binding RescanCommand}" />
          <Button Content="Scan folder…" Command="{Binding ScanFolderCommand}" />
          <Button Content="Restart as admin" Command="{Binding RestartAsAdminCommand}"
                  IsVisible="{Binding ShowAdminButton}"
                  ToolTip.Tip="Restart DiskLore with administrator rights to read protected folders" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Border Width="260" Height="30" CornerRadius="6" Background="{DynamicResource App.Background}"
                  BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                  IsVisible="{Binding HasResult}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="SearchBox" Classes="flat" Text="{Binding SearchText}" VerticalContentAlignment="Center"
                       Watermark="Search names, press Enter" KeyDown="OnSearchKeyDown" />
              <Button Grid.Column="1" Classes="ghost" Width="26" MinHeight="0" Height="26" Padding="0" Margin="0,0,2,0"
                      IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear search (Esc)">
                <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource App.TextMuted}" StrokeThickness="1.4"
                      StrokeLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
              </Button>
            </Grid>
          </Border>
          <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" Width="32" Padding="0">
            <TextBlock Text="⚙" FontSize="17" FontFamily="Segoe UI Symbol,Noto Sans Symbols2,Apple Symbols,Inter"
                       HorizontalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="12,0" MinHeight="26">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding AiStatus}" Classes="muted small" />
          <TextBlock Text="{Binding StatusText}" Classes="muted small" />
          <Border Padding="7,1" CornerRadius="9" Background="{DynamicResource App.SurfaceAlt}"
                  BorderBrush="{DynamicResource App.Border}" BorderThickness="1" IsVisible="{Binding IsElevated}">
            <TextBlock Text="Administrator" Classes="small" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding RuleCountText}" Classes="muted small" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" IsVisible="{Binding HasResult}">
          <TextBlock Text="{Binding RootPath}" Classes="small" FontWeight="SemiBold" MaxWidth="300"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TotalSizeText}" Classes="small" />
          <TextBlock Text="{Binding FilesText}" Classes="muted small" />
          <TextBlock Text="{Binding FoldersText}" Classes="muted small" />
          <TextBlock Text="{Binding ElapsedText}" Classes="muted small" />
          <Button Classes="link" Content="{Binding UnreadableText}" Command="{Binding ShowUnreadableCommand}"
                  IsVisible="{Binding HasUnreadable}" FontSize="12" Foreground="{DynamicResource App.Warning}"
                  ToolTip.Tip="Show the folders that couldn't be read" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel>
      <v:StartView x:Name="Start" IsVisible="{Binding ShowStart}" />
      <TabControl x:Name="Tabs" SelectedIndex="{Binding TabIndex, Mode=TwoWay}" IsVisible="{Binding !ShowStart}">
        <TabItem Header="Tree">
          <Grid ColumnDefinitions="*,Auto,420">
            <v:DiskTreeView x:Name="TreeTab" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="2" BorderBrush="{DynamicResource App.Border}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource App.Surface}" MinWidth="320">
              <v:DetailPanel x:Name="Detail" />
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Largest files"><t:LargestFilesView x:Name="LargestFilesTab" /></TabItem>
        <TabItem Header="File types"><t:FileTypesView x:Name="FileTypesTab" /></TabItem>
        <TabItem Header="Treemap"><t:TreemapView x:Name="TreemapTab" /></TabItem>
        <TabItem Header="Changes"><t:ChangesView x:Name="ChangesTab" /></TabItem>
      </TabControl>
    </Panel>
  </DockPanel>
</Window>
