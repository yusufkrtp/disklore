<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SystemAccentColor">#2563EB</Color>

  <SolidColorBrush x:Key="App.Background" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.Surface" Color="#F6F7F9" />
  <SolidColorBrush x:Key="App.SurfaceAlt" Color="#EDEFF3" />
  <SolidColorBrush x:Key="App.Border" Color="#D9DDE4" />
  <SolidColorBrush x:Key="App.Text" Color="#1A1D24" />
  <SolidColorBrush x:Key="App.TextMuted" Color="#5B6372" />
  <SolidColorBrush x:Key="App.Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.Bar" Color="#4F82F0" />
  <SolidColorBrush x:Key="App.BarTrack" Color="#E3E7EE" />
  <SolidColorBrush x:Key="App.Hover" Color="#EEF1F6" />
  <SolidColorBrush x:Key="App.Selection" Color="#DBE6FD" />
  <SolidColorBrush x:Key="App.Danger" Color="#C62828" />
  <SolidColorBrush x:Key="App.Warning" Color="#B45309" />

  <SolidColorBrush x:Key="Badge.Critical" Color="#C62828" />
  <SolidColorBrush x:Key="Badge.Shrink" Color="#B45309" />
  <SolidColorBrush x:Key="Badge.App" Color="#2563EB" />
  <SolidColorBrush x:Key="Badge.Check" Color="#7C3AED" />
  <SolidColorBrush x:Key="Badge.Safe" Color="#15803D" />
  <SolidColorBrush x:Key="Badge.Leftover" Color="#C2410C" />
  <SolidColorBrush x:Key="Badge.User" Color="#0F766E" />
  <SolidColorBrush x:Key="Badge.Unknown" Color="#6B7280" />
</ResourceDictionary>
